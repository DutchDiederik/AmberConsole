node_modules/

# Publish artifacts. `npm pack` drops amber-console-<version>.tgz in the repo
# root — 180kb of the repo, committed back into the repo.
*.tgz
*.log

# NEVER COMMIT THIS. `npm login` and `npm token` can write an auth token into a
# project-local .npmrc, and committing one publishes a credential that can push
# to this package. Ignored by default; if you ever need a checked-in .npmrc for
# registry config, `git add -f .npmrc` after checking there is no token in it.
.npmrc
.env
.env.*

# Visual-regression run output — written only for a capture that FAILED, so it
# can be eyeballed against its baseline. Throwaway; the next run rewrites it.
test/visual/*.actual.png

# scripts/make-assets.mjs unlinks this; it only survives a crashed run.
docs/.make-assets.tmp.html

# Local tool state, machine-specific
.claude/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# VISUAL BASELINES, DELIBERATELY OUT OF THE REPO FOR NOW.
#
# 11.6MB of PNGs was the largest thing in here by a wide margin, so the
# baselines are kept local until the 2.0 tag, when one final set goes in.
# This was 157 hand-listed filenames — the same 44 files enumerated three
# times over — and it contradicted the comment above test/visual/*.actual.png,
# which claimed baselines/ was committed. One glob says the same thing and
# cannot drift as pages are added.
#
# WHAT THIS COSTS UNTIL THE TAG: `npm run test:visual` on a fresh clone
# reports MISSING for every capture and fails. Run it with --update once to
# seed a local set. The 30 baselines that were committed before this rule
# existed stay tracked — an ignore does not untrack — so they still compare.
test/visual/baselines/*.png
